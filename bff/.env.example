# Puerto del BFF
PORT=3000
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200
# URL base de PokéAPI (útil para apuntar a un mock u otra instancia)
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# Timeout por petición a PokéAPI (ms)
POKEAPI_TIMEOUT_MS=8000
# Tiempo de vida de la caché en memoria (ms). Por defecto, 1 hora.
CACHE_TTL_MS=3600000